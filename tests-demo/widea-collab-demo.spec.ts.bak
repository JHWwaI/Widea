import { test, Page, BrowserContext } from '@playwright/test';
import fs from 'node:fs';
import path from 'node:path';

const state = JSON.parse(
  fs.readFileSync(path.join(__dirname, '.demo-state.json'), 'utf8'),
) as {
  founder: { email: string; password: string; userId: string; name: string; userCode: string };
  expert: { email: string; password: string; userId: string; name: string; userCode: string };
  ideaId: string;
};

async function injectOverlay(page: Page) {
  try {
    await page.addStyleTag({
      content: `
        #__demo_sub {
          position: fixed; left: 50%; bottom: 36px; transform: translateX(-50%);
          background: rgba(15,15,20,0.92); color: #fff;
          padding: 14px 28px; border-radius: 14px;
          font-size: 19px; line-height: 1.45;
          font-family: -apple-system, BlinkMacSystemFont, "Pretendard", "Apple SD Gothic Neo", sans-serif;
          z-index: 999999; max-width: 80%; text-align: center;
          box-shadow: 0 12px 32px rgba(0,0,0,0.35);
          border: 1px solid rgba(255,255,255,0.08);
          backdrop-filter: blur(6px);
        }
        #__demo_badge {
          position: fixed; top: 24px; left: 24px;
          background: linear-gradient(135deg,#6366f1,#8b5cf6);
          color: #fff; padding: 8px 16px; border-radius: 999px;
          font-size: 13px; font-weight: 600; letter-spacing: .3px;
          font-family: -apple-system, sans-serif;
          z-index: 999999; box-shadow: 0 6px 18px rgba(99,102,241,0.4);
        }
      `,
    });
    await page.evaluate(() => {
      if (!document.getElementById('__demo_sub')) {
        const sub = document.createElement('div');
        sub.id = '__demo_sub';
        document.body.appendChild(sub);
      }
      if (!document.getElementById('__demo_badge')) {
        const b = document.createElement('div');
        b.id = '__demo_badge';
        b.textContent = '🎬 Widea — 팀 결성 시연';
        document.body.appendChild(b);
      }
    });
  } catch {}
}

async function say(page: Page, text: string, holdMs = 0) {
  await injectOverlay(page);
  try {
    await page.evaluate((t) => {
      const el = document.getElementById('__demo_sub');
      if (el) el.textContent = t;
    }, text);
  } catch {}
  if (holdMs > 0) await page.waitForTimeout(holdMs);
}

async function tryClick(page: Page, fn: () => Promise<void>) {
  try { await fn(); } catch {}
}

async function loginViaUI(page: Page, email: string, password: string) {
  await page.goto('/login');
  await page.locator('#email').fill(email);
  await page.locator('#password').fill(password);
  await tryClick(page, async () => {
    await page.getByRole('button', { name: /로그인|Login/ }).first().click();
  });
  await page.waitForLoadState('domcontentloaded').catch(() => {});
}

// 전문가 봇 — 협업 요청 수락 + 채팅 자동 답신
async function expertBot(page: Page, ideaId: string) {
  await loginViaUI(page, state.expert.email, state.expert.password);
  await page.waitForTimeout(1500);

  // 1) 알림함 → 새 요청 polling → 수락
  await page.goto('/mypage/inbox').catch(() => {});
  const acceptDeadline = Date.now() + 60_000;
  let accepted = false;
  while (Date.now() < acceptDeadline && !accepted) {
    // 페이지 새로고침해 새 요청 반영
    await page.reload({ waitUntil: 'domcontentloaded' }).catch(() => {});
    await page.waitForTimeout(800);
    const acceptBtn = page.getByRole('button', { name: /수락/ }).first();
    if (await acceptBtn.count()) {
      await acceptBtn.click({ timeout: 4000 }).catch(() => {});
      accepted = true;
      break;
    }
    await page.waitForTimeout(1500);
  }

  // 2) 워크스페이스 합류 후 채팅 답장
  await page.goto(`/workspace/${ideaId}`).catch(() => {});
  await page.waitForTimeout(2000);

  // 새 메시지 도착 대기 — 이전 메시지 카운트 기준
  const initialCount = await page.locator('text=/디자인 시안/i').count();
  const replyDeadline = Date.now() + 60_000;
  while (Date.now() < replyDeadline) {
    const cur = await page.locator('text=/디자인 시안/i').count();
    if (cur > initialCount) break;
    await page.waitForTimeout(1000);
  }

  // 답장 입력
  await page.waitForTimeout(2500);
  const input = page.locator('textarea[placeholder*="메시지를 입력"]').first();
  if (await input.count()) {
    await input.fill('넵! 오늘 안에 시안 1차 드릴게요 🎨');
    await page.waitForTimeout(400);
    await tryClick(page, async () => {
      await page.getByRole('button', { name: '전송' }).first().click();
    });
  }
}

// 창업자 데모 — 1인칭 카메라
async function founderDemo(page: Page, ideaId: string) {
  await loginViaUI(page, state.founder.email, state.founder.password);
  await page.waitForTimeout(1000);

  // ── Intro
  await page.goto(`/workspace/${ideaId}?tab=stages`);
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await page.waitForTimeout(1500);
  await say(page, '"오토" 워크스페이스 — 6단계 중 2단계 완료, 기획·설계 진행 중.', 4000);

  // 첫 단계 펼쳐 보기
  await tryClick(page, async () => {
    await page.locator('button').filter({ hasText: /기획·설계|3단계/ }).first().click();
  });
  await say(page, '단계를 펼치면 작업·담당자·기한을 관리할 수 있어요.', 2500);

  // ── 1) 팀원 모집 게시글 작성
  await page.goto('/community/new?category=TEAM_RECRUIT');
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await say(page, '먼저 커뮤니티에 팀원 모집 글을 올립니다.', 1800);

  // 제목 / 본문 입력
  const titleInput = page.locator('input[placeholder*="제목"], input[name="title"]').first();
  if (await titleInput.count()) {
    await titleInput.fill('UI/UX 디자이너 1명 모십니다 (B2B SaaS · 4주 MVP)');
  }
  const bodyArea = page.locator('textarea').first();
  if (await bodyArea.count()) {
    await bodyArea.fill('역할: UI/UX 디자이너\n기간: 4주 (MVP 빌드)\n보상: 초기 멤버 지분 + 월 30만원\n함께 0→1 만들 분을 찾습니다.');
  }
  await page.waitForTimeout(1500);
  await say(page, '역할·기간·보상을 적어 즉시 게시합니다.', 1800);
  await tryClick(page, async () => {
    await page.getByRole('button', { name: /게시|등록|발행/ }).first().click();
  });
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await page.waitForTimeout(1500);

  // ── 2) 전문가 풀에서 디자이너 검색 → 프로필
  await page.goto('/talent');
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await say(page, '전문가 풀에서 디자이너를 빠르게 찾아봅니다.', 2000);
  // bob 프로필로 직접 이동 (검색 UI 의존 안 함)
  await page.goto(`/u/${state.expert.userId}`);
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await page.waitForTimeout(1200);
  await say(page, '"이도윤" — UI/UX 디자이너. 프로필을 확인하고 협업 요청.', 3500);

  // ── 3) 협업 요청 보내기
  await tryClick(page, async () => {
    await page.getByText(/워크스페이스 협업 요청/).first().click();
  });
  await page.waitForTimeout(800);
  // 메시지 입력
  const msg = page.locator('textarea').first();
  if (await msg.count()) {
    await msg.fill('"오토" 워크스페이스 디자인 합류 부탁드립니다. 기획·설계부터 함께해요!');
  }
  await page.waitForTimeout(1200);
  await say(page, '워크스페이스 "오토"를 선택하고 메시지와 함께 요청 전송.', 2200);
  await tryClick(page, async () => {
    await page.getByRole('button', { name: /요청 보내기|전송/ }).first().click();
  });
  await page.waitForTimeout(1500);
  await say(page, '요청이 전송됐습니다. 전문가가 알림을 받습니다.', 2200);

  // ── 4) 워크스페이스 멤버 탭으로 — 봇이 수락하는 동안 (수락 ≈ 8~15s 소요)
  await say(page, '전문가가 수락하면 워크스페이스에 자동 합류됩니다.', 1500);
  // 수락 대기 — 멤버 탭 polling
  const memberDeadline = Date.now() + 30_000;
  let bobJoined = false;
  while (Date.now() < memberDeadline && !bobJoined) {
    await page.goto(`/workspace/${ideaId}?tab=members`).catch(() => {});
    await page.waitForLoadState('domcontentloaded').catch(() => {});
    await page.waitForTimeout(1500);
    if (await page.getByText(state.expert.name).count()) {
      bobJoined = true;
      break;
    }
    await page.waitForTimeout(1000);
  }
  await say(page, `멤버 탭에 "${state.expert.name}"이(가) 합류했습니다 — 원클릭 수락.`, 3500);

  // ── 5) 실시간 채팅 (★ 클라이맥스)
  await page.goto(`/workspace/${ideaId}?tab=stages`);
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await page.waitForTimeout(1500);
  await say(page, '워크스페이스 채팅으로 바로 대화 시작.', 1800);

  const chatInput = page.locator('textarea[placeholder*="메시지를 입력"]').first();
  if (await chatInput.count()) {
    await chatInput.fill('@이도윤 디자인 시안 부탁드려요!');
    await page.waitForTimeout(500);
    await tryClick(page, async () => {
      await page.getByRole('button', { name: '전송' }).first().click();
    });
  }
  await say(page, '"@이도윤 디자인 시안 부탁드려요!" — WebSocket 실시간 전달.', 2500);

  // 봇 답장 대기
  const replyDeadline = Date.now() + 25_000;
  let replyArrived = false;
  while (Date.now() < replyDeadline) {
    if (await page.getByText(/오늘 안에 시안/).count()) {
      replyArrived = true;
      break;
    }
    await page.waitForTimeout(800);
  }
  if (replyArrived) {
    await say(page, `"${state.expert.name}"의 답장이 즉시 도착 — 양방향 실시간 협업.`, 4000);
  } else {
    await say(page, '메시지가 양방향으로 실시간 전달됩니다.', 3000);
  }

  // ── 6) 회의 일정 추가
  await page.goto(`/workspace/${ideaId}?tab=meetings`);
  await page.waitForLoadState('domcontentloaded').catch(() => {});
  await page.waitForTimeout(1500);
  await say(page, '미팅 탭에서 다음 회의 일정을 잡습니다.', 2500);

  // ── Outro
  await say(page, 'Widea — 팀 모집부터 실시간 협업까지 한 화면에서.', 3500);
}

test('Widea — 팀 결성 시연 (창업자 1인칭 + 전문가 백그라운드 봇)', async ({ browser }) => {
  test.setTimeout(360_000);

  // Two contexts: founder records video, expert is silent bot
  const founderCtx: BrowserContext = await browser.newContext({
    viewport: { width: 1440, height: 900 },
    recordVideo: { dir: path.join(__dirname, 'recordings/founder'), size: { width: 1440, height: 900 } },
  });
  const expertCtx: BrowserContext = await browser.newContext({
    viewport: { width: 1280, height: 800 },
  });

  const founderPage = await founderCtx.newPage();
  const expertPage = await expertCtx.newPage();

  await Promise.all([
    founderDemo(founderPage, state.ideaId),
    expertBot(expertPage, state.ideaId),
  ]);

  await founderCtx.close();
  await expertCtx.close();
});
